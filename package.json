{
  "name": "codex-copilot",
  "description": "[DEPRECATED] Codex Copilot for translation support. Includes chat, comments, and inline AI text completions.",
  "version": "0.1.0",
  "publisher": "project-accelerate",
  "private": true,
  "deprecated": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/genesis-ai-dev/codex-comments-and-chat"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack",
    "watch": "webpack --watch",
