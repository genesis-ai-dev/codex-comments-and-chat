    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^20.11.25",
    "@types/uuid": "^9.0.7",
    "@types/vscode": "^1.73.0",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.32.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@types/axios": "^0.14.0",
    "@vscode/codicons": "^0.0.35",
    "@vscode/test-electron": "^2.3.10",
    "axios": "^1.7.2",
    "child_process": "^1.0.2",
